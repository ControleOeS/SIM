# Modelo do painel "Secrets" do Streamlit Community Cloud (App settings → Secrets).
# NÃO coloque valores reais neste arquivo: ele vai para o repositório. Os valores reais ficam só no painel.
# Cada chave vira variável de ambiente lida por sim/config.py (ver app.py::_segredos_para_ambiente).

# Endereço de conexão do Neon (Dashboard → Connect). O SIM converte "postgresql://" para o driver psycopg 3.
DATABASE_URL = "postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# O disco da hospedagem é apagado a cada reinício: anexos ficam no banco.
SIM_ANEXOS_BACKEND = "banco"

# Limite por arquivo (o plano gratuito do Neon tem pouco espaço).
SIM_MAX_ANEXO_MB = "20"

# Código pedido na tela de configuração inicial (primeiro Controle Geral). Use um valor longo e aleatório.
SIM_CODIGO_CONFIGURACAO = "troque-por-um-codigo-longo-e-aleatorio"

# Logs no painel "Manage app" da hospedagem.
SIM_LOG_CONSOLE = "true"

# Envio de e-mail ainda não configurado (redefinição de senha fica indisponível).
SIM_EMAIL_MODO = "desativado"
