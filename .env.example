# Copie para ".env" e ajuste. O arquivo .env NÃO vai para o Git.
# Sem .env, o SIM usa os padrões abaixo (SQLite local em data/).

# Pasta de dados local (banco SQLite, anexos e logs). Caminho relativo à pasta do projeto ou absoluto.
SIM_DATA_DIR=data

# Banco de dados (URL do SQLAlchemy). Padrão: SQLite em <SIM_DATA_DIR>/sim.db
# Para o banco corporativo, o TI informará a URL e o driver. Exemplos ilustrativos (não usar sem o TI):
#   DATABASE_URL=mssql+pyodbc://USUARIO:SENHA@SERVIDOR/BANCO?driver=ODBC+Driver+18+for+SQL+Server
#   DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@SERVIDOR:5432/BANCO
# DATABASE_URL=sqlite:///C:/caminho/para/sim.db

# Anexos (armazenamento local provisório) e logs
# SIM_ANEXOS_DIR=data/anexos
# SIM_LOGS_DIR=data/logs
# SIM_MAX_ANEXO_MB=50

# Aplica as migrações automaticamente ao iniciar. Em produção, use false e rode "alembic upgrade head".
SIM_AUTO_MIGRATE=true

# Mostra o SQL executado no terminal (diagnóstico)
SIM_SQL_ECHO=false

# E-mail (usado na redefinição de senha por código). Modos:
#   desativado  -> a opção "Esqueci a senha" informa que o envio não está configurado (padrão)
#   arquivo     -> SOMENTE DESENVOLVIMENTO: grava cada e-mail como .eml em <SIM_DATA_DIR>/emails
#   smtp        -> envia de verdade pelo servidor abaixo (o TI fornece os dados; a senha nunca vai para o Git)
SIM_EMAIL_MODO=desativado
# SIM_EMAIL_REMETENTE=sim@empresa.com.br
# SIM_SMTP_HOST=smtp.office365.com
# SIM_SMTP_PORTA=587
# SIM_SMTP_STARTTLS=true
# SIM_SMTP_USUARIO=sim@empresa.com.br
# SIM_SMTP_SENHA=
